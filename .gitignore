# Runtime state - sikrer at git reset --hard origin/main ikke murderer state mellom auto-update-runs.
# Credentials og secrets (~/.config/foundry/secrets.env, ~/.claude/.credentials.json) lever
# per design utenfor ~/foundry/-treet - ingen .gitignore-oppføring nødvendig, men flytt aldri
# disse filene inn i repo-mappa.

# Per-jobb venvs
*/.venv/
**/.venv/

# Runtime queues og logger
queue/
logs/

# Job state-filer
jobs/*/.state.json
**/.state.json

# Deploy-lock
.deploy.lock

# Python cache
**/__pycache__/
*.pyc

# Claude Code local settings (per-machine)
.claude/

# Graphify: the generated code graph is regenerable and ignored. The versioned
# name layer is the curated sidecar below - keyed on a cluster identity that is
# stable across build lines, curated names only, merged by git's union driver
# (see .gitattributes). The int-keyed .graphify_labels.json is a LOCAL build
# artifact: graphify reads it, heal and rebuild regenerate it, nothing commits it.
graphify-out/*
!graphify-out/.graphify-labels.jsonl
